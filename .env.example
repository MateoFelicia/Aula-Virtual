# Copiá este archivo como ".env" y completá los valores.
# El .env real está en .gitignore: nunca se sube al repo.

# Clave para firmar sesiones y tokens (generar una random larga)
SECRET_KEY=cambiar-por-una-clave-random

# ---- Gmail para emails de confirmación ----
# Requiere verificación en 2 pasos + contraseña de aplicación:
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=clave-de-aplicacion-de-16-letras
MAIL_DEFAULT_SENDER=tu-email@gmail.com

# Base para armar los links de los emails
BASE_URL=http://localhost:5001

# Opcional: si se define, reemplaza al SQLite provisorio (ej: MySQL)
# DATABASE_URL=mysql+pymysql://usuario:password@localhost/aula_virtual
